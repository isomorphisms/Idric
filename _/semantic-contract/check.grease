#!/usr/bin/env grease
var repo = $1
var compiler = $2
if (not repo.startsWith('/')) { echo 'requires absolute Idriç source root' >&2; exit 2 }
test -x "$compiler"
var stage = "$(mktemp -d)"
cp "$repo/_/examples/unified-higher-mathematics/MathematicalSpaces.idric" "$stage/"
cp "$repo/_/examples/unified-higher-mathematics/EuclideanGeometry.idric" "$stage/"
cp "$repo/examples/autogenerated/fragment-semantic-contract/Pairing32.idric" "$stage/"
cd -- "$stage"
"$compiler" --check Pairing32.idric
sha256sum MathematicalSpaces.idric EuclideanGeometry.idric Pairing32.idric
echo 'PASS exact 32D pairing propositions and role/space refusal declarations'
