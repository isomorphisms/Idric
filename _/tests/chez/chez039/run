. ../../testutils.sh

# Golden.runTest fixes this file's interpreter to sh. Failures must also be
# visible on stdout because that harness compares output independently of exit.
fixture_root="$test_dir/../../../../examples/autogenerated/chez-output-paths"
mkdir -p build
printf '%s\n' 'chez-path-ready 東京🙂' > build/expected-program.txt

compile_and_run() {
    label=$1
    output_component=$2
    source="$fixture_root/$3"
    output_root="$test_dir/build/$output_component"
    if ! idris2_no_clean --quiet --cg chez --source-dir "$fixture_root" --build-dir "$output_root" "$source" -o path-consumer > "build/$label.compile.stdout" 2> "build/$label.compile.stderr"; then
        printf '%s\n' "$label=FAIL: compiler exited unsuccessfully"
        exit 1
    fi
    if [ ! -x "$output_root/exec/path-consumer" ]; then
        printf '%s\n' "$label=FAIL: executable absent"
        exit 1
    fi
    if ! "$output_root/exec/path-consumer" > "build/$label.program.stdout" 2> "build/$label.program.stderr"; then
        printf '%s\n' "$label=FAIL: generated program exited unsuccessfully"
        exit 1
    fi
    if ! cmp build/expected-program.txt "build/$label.program.stdout"; then
        printf '%s\n' "$label=FAIL: generated program output changed"
        exit 1
    fi
    printf '%s\n' "$label=PASS"
}

compile_and_run idric-ascii ascii PathConsumer.idric
compile_and_run idric-space 'with spaces' PathConsumer.idric
compile_and_run idric-apostrophe "with'apostrophe" PathConsumer.idric
compile_and_run idric-bmp 東京 PathConsumer.idric
compile_and_run idric-non-bmp 🙂 PathConsumer.idric
compile_and_run idr-compatibility 'with spaces 東京🙂' Compatibility.idr
