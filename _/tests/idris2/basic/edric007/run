. ../../../testutils.sh

fixture_dir=build/units-time-intervals
mkdir -p "$fixture_dir"
cp ../../../../examples/units-time-intervals/UnitsTimeIntervals.idric "$fixture_dir/UnitsTimeIntervals.idr"
cp ../../../../examples/units-time-intervals/Tests.idric "$fixture_dir/Tests.idr"

(
    cd "$fixture_dir"
    "$idris2" Tests.idr -o units-time-intervals >/dev/null
    ./build/exec/units-time-intervals
) || exit 1

# This file is the smoke runner's fixed POSIX-shell interface. Keep the
# source-location guards here, rather than adding owned shell logic to CI.
test ! -e Tests.idr || exit 1
test ! -e UnitsTimeIntervals.idr || exit 1
cmp ../../../../examples/units-time-intervals/Tests.idric "$fixture_dir/Tests.idr" || exit 1
cmp ../../../../examples/units-time-intervals/UnitsTimeIntervals.idric "$fixture_dir/UnitsTimeIntervals.idr" || exit 1
source_status=$(git status --porcelain --untracked-files=all -- .) || exit 1
test -z "$source_status" || exit 1
