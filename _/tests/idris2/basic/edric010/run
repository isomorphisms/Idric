#!/bin/sh
set -eu

. ../../../testutils.sh

if ! "$idris2" --check Valid.idric >valid.log 2>&1; then
  cat valid.log >&2
  exit 1
fi
printf '%s\n' 'Number and ±Number accepted values and arithmetic: PASS'

if "$idris2" --check ZeroIsNotNumber.idric >zero.log 2>&1; then
  printf '%s\n' '0 unexpectedly elaborated as Number' >&2
  exit 1
fi
printf '%s\n' 'zero rejected as Number: PASS'

if "$idris2" --check NegativeIsNotNumber.idric >negative.log 2>&1; then
  printf '%s\n' 'negative literal unexpectedly elaborated as Number' >&2
  exit 1
fi
printf '%s\n' 'negative value rejected as Number: PASS'

if ! "$idris2" --check IdrisCompatibility.idr >compatibility.log 2>&1; then
  cat compatibility.log >&2
  exit 1
fi
printf '%s\n' 'ordinary .idr numeric inference preserved: PASS'
