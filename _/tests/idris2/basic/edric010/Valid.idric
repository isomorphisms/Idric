module Valid

one : Number
one = 1

two : Number
two = 2

minus_one : ±Number
minus_one = -1

unicode_minus_one : ±Number
unicode_minus_one = −1

zero : ±Number
zero = 0

positive_signed : ±Number
positive_signed = 1

difference : ±Number
difference = one - two

positive_sum : Number
positive_sum = one + two

positive_product : Number
positive_product = one * two

accept_signed : ±Number -> ±Number
accept_signed value = value

widened : ±Number
widened = accept_signed (numberAsSigned one)
