set -e
. ../../../testutils.sh

run Main.idric

# Compile the proposed exact-integer model separately from the inherited operator.
model=build/signed-ordinary-division
mkdir -p "$model"
source_dir=../../../../../examples/autogenerated/signed-ordinary-division
cp "$source_dir/Main.idric" "$source_dir/SignedDivision.idric" "$model/"
(
    cd "$model"
    if ! "$idris2" --check SignedDivision.idric >producer.log 2>&1; then
        cat producer.log >&2
        exit 1
    fi
    # Build the client against the checked interface with the producer source absent.
    mv SignedDivision.idric SignedDivision.idric.source
    "$idris2" --cg chez -o signed-division Main.idric
    ./build/exec/signed-division
    ./build/exec/signed-division 7 -3
    ./build/exec/signed-division -7 -3
    ./build/exec/signed-division -7 0
    ./build/exec/signed-division 7 3 5
    ./build/exec/signed-division -7 -3 5
    ./build/exec/signed-division -7 3 -5
    ./build/exec/signed-division 7 3 -5
    ./build/exec/signed-division 0 -3 5
    ./build/exec/signed-division 7 0 -5
    ./build/exec/signed-division -7 -3 0
    ./build/exec/signed-division 1 4294967296 -4294967296
)
