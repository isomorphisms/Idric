set -e
. ../../../testutils.sh

run Main.idric

# Compile the proposed exact-integer model separately from the inherited operator.
model=build/signed-ordinary-division
mkdir -p "$model"
cp ../../../../../examples/autogenerated/signed-ordinary-division/Main.idric "$model/Main.idric"
(
    cd "$model"
    "$idris2" --cg chez -o signed-division Main.idric
    ./build/exec/signed-division
    ./build/exec/signed-division 7 -3
    ./build/exec/signed-division -7 -3
    ./build/exec/signed-division -7 0
)
