#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
bundle_root=$(CDPATH='' cd -- "$script_dir/.." && pwd)
idris_version=@IDRIS2_VERSION@
idric_prefix="$bundle_root/idric"
idric_app="$bundle_root/libexec/idric"
idric_lib="$idric_prefix/idris2-$idris_version/lib"
chez="$bundle_root/chez/bin/scheme"

export IDRIS2_PREFIX="$idric_prefix"
export IDRIS2_INC_SRC="$idric_app"
export CHEZ="$chez"

if [ "${LD_LIBRARY_PATH:-}" = '' ]; then
	LD_LIBRARY_PATH=$idric_lib
else
	LD_LIBRARY_PATH="$idric_lib:$LD_LIBRARY_PATH"
fi
export LD_LIBRARY_PATH

exec "$chez" --program "$idric_app/idris2.so" "$@"
