#!/usr/bin/env grease
# Synthetic process fixture only: no source is compiled.
var variant = ENV.SMOKE_GUARD_VARIANT
var source = ENV.SMOKE_GUARD_SOURCE
mkdir -p build/exec
cp "$source/examples/autogenerated/source-clean-smoke/fixture-child.grease" build/exec/units-time-intervals
chmod 755 build/exec/units-time-intervals
if (variant === 'stray-source') {
  cp Tests.idr ../../Tests.idr
} elif (variant === 'changed-copy') {
  printf '\n' >> Tests.idr
} elif (variant === 'git-read-failure') {
  printf 'invalid fixture HEAD\n' > "$[ENV.SMOKE_GUARD_FIXTURE_ROOT]/.git/HEAD"
}
if (variant === 'compiler-exit') { exit 23 }
