#!/usr/bin/env grease
# Exercise the real fixed sh test interface in new disposable Git fixtures.
# These synthetic compiler/child processes do not establish compiler acceptance.
if (int($#) !== 3) { echo 'requires ABSOLUTE_GREASE ABSOLUTE_SOURCE ABSOLUTE_NEW_OUTPUT' >&2; exit 2 }
var grease = $1
var source = $2
var output = $3
for path in "$grease" "$source" "$output" { case "$path" in /*) ;; *) exit 2 ;; esac }
test -x "$grease"
test ! -e "$output"
mkdir -p "$output"
var runtime = "$(dirname -- "$grease")"
var expected = "$source/_/tests/idris2/basic/edric007/expected"
printf 'variant\tprocess_exit\tgolden_equal\n' > "$output/results.tsv"
for variant in clean compiler-exit compiled-exit stray-source changed-copy git-read-failure {
  var fixture = "$output/$variant"
  var leaf = "$fixture/_/tests/idris2/basic/edric007"
  mkdir -p "$leaf" "$fixture/_/examples/units-time-intervals"
  cp "$source/_/tests/idris2/basic/edric007/run" "$leaf/run"
  cp "$source/_/tests/testutils.sh" "$fixture/_/tests/testutils.sh"
  cp "$source/_/examples/units-time-intervals/Tests.idric" "$fixture/_/examples/units-time-intervals/Tests.idric"
  cp "$source/_/examples/units-time-intervals/UnitsTimeIntervals.idric" "$fixture/_/examples/units-time-intervals/UnitsTimeIntervals.idric"
  printf 'build/\nprefix/\n' > "$fixture/.gitignore"
  git -C "$fixture" init -q
  git -C "$fixture" add .
  git -C "$fixture" -c user.name=synthetic-fixture -c user.email=fixture@invalid.local commit -qm 'Synthetic guard input'
  cd -- "$leaf"
  try {
    env PATH="$runtime:$[ENV.PATH]" SMOKE_GUARD_VARIANT="$variant" \
      SMOKE_GUARD_SOURCE="$source" SMOKE_GUARD_EXPECTED="$expected" \
      SMOKE_GUARD_FIXTURE_ROOT="$fixture" \
      sh ./run "$source/examples/autogenerated/source-clean-smoke/fixture-compiler.grease" \
      > "$output/$variant.stdout" 2> "$output/$variant.stderr"
  }
  var process = _error.code
  cd -- "$source"
  if (variant === 'clean') {
    test "$process" = 0
    cmp "$expected" "$output/$variant.stdout"
    printf '%s\t%s\ttrue\n' "$variant" "$process" >> "$output/results.tsv"
  } else {
    test "$process" = 1
    grep -F 'FAIL: fixture source guard:' "$output/$variant.stdout"
    try { cmp "$expected" "$output/$variant.stdout" > "$output/$variant.compare" 2>&1 }
    if (_error.code === 0) { echo 'FAIL: ignored process status would hide the guard failure' >&2; exit 1 }
    printf '%s\t%s\tfalse\n' "$variant" "$process" >> "$output/results.tsv"
  }
}
sha256sum "$grease" "$source/_/tests/idris2/basic/edric007/run" > "$output/source-runtime.sha256"
printf '\033[32mPASS\033[0m real fixed smoke interface; clean output preserved and five failures cannot match golden stdout\n'
