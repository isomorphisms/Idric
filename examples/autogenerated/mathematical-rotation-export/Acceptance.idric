module Acceptance

import Data.Text
import System
import System.Directory
import System.File

-- Process execution is kept here, below the mathematical and artifact tests.
-- Each argument is quoted as one POSIX process argument; there are no shell
-- programs, pipelines, downloaded commands or interpolated source fragments.
quote_argument : Text → Text
quote_argument value = "'" ++ concatMap
  (\character ⇒ if character ≟ '\'' then "'\\''" else singleton character)
  (unpack value) ++ "'"

assert_result : Text → Bool → IO ()
assert_result description True = putStrLn ("PASS " ++ description)
assert_result description False = do
  putStrLn ("FAIL " ++ description)
  exitFailure

run_command : Bool → List Text → IO ()
run_command expected_success arguments = do
  status ← system (unwords (map quote_argument arguments))
  assert_result (unwords arguments ++ " [status " ++ show status ++ "]")
    ((status ≟ 0) ≟ expected_success)

covering
save_source : Text → Text → IO ()
save_source path text = do
  Right () ← writeFile path text
    | Left error ⇒ do putStrLn (show error); exitFailure
  pure ()

covering
copy_source : Text → Text → IO ()
copy_source source destination = do
  Right text ← readFile source
    | Left error ⇒ do putStrLn (show error); exitFailure
  save_source destination text

fixture_source : Text → Text → Text
fixture_source signature body = unlines
  [ "module Negative"
  , "import MathematicalSpaces"
  , "import EuclideanGeometry"
  , "import MathematicalRotations"
  , "import Data.So"
  , "%unbound_implicits off"
  , "public export"
  , "mathematical_rotation : " ++ signature
  , "mathematical_rotation = " ++ body
  , "main : IO ()"
  , "main = pure ()"
  ]

rotation_type : Text
rotation_type = "Rotation {space = real128_space} real128_euclidean \"standard-positive\""

covering
reject_source : Text → Text → Text → IO ()
reject_source compiler description source = do
  save_source "Negative.idric" source
  ignore ← removeFile "build/exec/negative.math"
  run_command False [compiler, "--cg", "idric-mathematical", "--directive",
                    "root=mathematical_rotation", "Negative.idric", "-o", "negative.math"]
  artifact ← readFile "build/exec/negative.math"
  case artifact of
    Left _ ⇒ assert_result description True
    Right _ ⇒ assert_result (description ++ " left an accepted artifact") False

covering
acceptance : Text → Text → IO ()
acceptance compiler root = do
  let working = root ++ "/_/build/mathematical-ir"
  ignore ← createDir (root ++ "/_/build")
  ignore ← createDir working
  entered ← changeDir working
  assert_result "acceptance workspace" entered
  ignore ← createDir "Compiler"
  traverse_ (\name ⇒ copy_source
    (root ++ "/_/examples/unified-higher-mathematics/" ++ name ++ ".idric")
    (name ++ ".idric")) ["MathematicalSpaces", "EuclideanGeometry", "MathematicalRotations"]
  traverse_ (\name ⇒ copy_source
    (root ++ "/examples/autogenerated/mathematical-rotation-export/" ++ name ++ ".idric")
    (name ++ ".idric")) ["RotationTests", "RotationExport", "ArtifactTests"]
  copy_source (root ++ "/Compiler/MathematicalIR.idr") "Compiler/MathematicalIR.idr"
  run_command True [compiler, "--cg", "chez", "RotationTests.idric", "-o", "rotation-tests"]
  run_command True [working ++ "/build/exec/rotation-tests"]
  run_command True [compiler, "--cg", "chez", "ArtifactTests.idric", "-o", "artifact-tests"]
  run_command True [compiler, "--cg", "idric-mathematical", "--directive",
                    "root=mathematical_rotation", "RotationExport.idric", "-o", "rotation.math"]
  run_command True [working ++ "/build/exec/artifact-tests", "--artifact", "build/exec/rotation.math"]
  run_command False [compiler, "--cg", "idric-mathematical", "RotationExport.idric", "-o", "missing-root.math"]
  run_command False [compiler, "--cg", "unavailable-negative-backend", "RotationExport.idric", "-o", "unknown.math"]
  reject_source compiler "forged unit evidence rejected"
    (fixture_source rotation_type "ClosedPlane 0 1 1 1 1 (believe_me Oh)")
  reject_source compiler "forged axis evidence rejected"
    (fixture_source rotation_type "ClosedPlane 0 128 0 1 1 (believe_me Oh)")
  reject_source compiler "wrong root type rejected" (fixture_source "Integer" "7")
  reject_source compiler "unresolved evidence rejected"
    (fixture_source rotation_type "ClosedPlane 0 1 0 1 1 ?missing_evidence")
  reject_source compiler "forged frame coercion rejected"
    (fixture_source rotation_type
      "believe_me (the (Rotation {space = real128_space} real128_euclidean \"different-frame\") ClosedIdentity)")
  -- A different valid graph is valid mathematics, but cannot satisfy this
  -- consumer's expected result. Both the zero/identity and sign mutants must
  -- reach the comparator and fail with a nonzero process status.
  save_source "Negative.idric" (fixture_source rotation_type "ClosedIdentity")
  run_command True [compiler, "--cg", "idric-mathematical", "--directive",
                    "root=mathematical_rotation", "Negative.idric", "-o", "wrong.math"]
  run_command False [working ++ "/build/exec/artifact-tests", "--artifact", "build/exec/wrong.math"]
  save_source "Negative.idric" (fixture_source rotation_type "ClosedPlane 0 1 0 (-1) 1 Oh")
  run_command True [compiler, "--cg", "idric-mathematical", "--directive",
                    "root=mathematical_rotation", "Negative.idric", "-o", "wrong-sign.math"]
  run_command False [working ++ "/build/exec/artifact-tests", "--artifact", "build/exec/wrong-sign.math"]
  putStrLn "PASS checked mathematical export acceptance"

covering
main : IO ()
main = do
  arguments ← getArgs
  case drop 1 arguments of
    [compiler, root] ⇒ do
      assert_result "absolute compiler and repository paths"
        (isPrefixOf "/" compiler && isPrefixOf "/" root)
      acceptance compiler root
    _ ⇒ do putStrLn "expected absolute COMPILER and REPOSITORY paths"; exitFailure
