module SignedDivision

record ExactRatio where
  constructor Ratio
  numerator : Integer
  positive_denominator : Integer

-- Embedding a rational in the complex field fixes its imaginary part at zero.
export
data OrdinaryQuotient = ZeroDivisor | RealRatio ExactRatio | ComplexOfReal ExactRatio

export
ordinary_quotient : Integer → Integer → OrdinaryQuotient
ordinary_quotient dividend divisor =
  if divisor ≟ 0 then ZeroDivisor else
    let ratio = if divisor < 0 then Ratio (negate dividend) (negate divisor)
                               else Ratio dividend divisor
    in if dividend < 0 || divisor < 0 then ComplexOfReal ratio else RealRatio ratio

-- A complex value stays complex when its exact real coordinate changes sign.
as_complex : OrdinaryQuotient → OrdinaryQuotient
as_complex (RealRatio ratio) = ComplexOfReal ratio
as_complex other = other

export
divide_quotient_by_integer : OrdinaryQuotient → Integer → OrdinaryQuotient
divide_quotient_by_integer ZeroDivisor _ = ZeroDivisor
divide_quotient_by_integer (RealRatio ratio) divisor =
  ordinary_quotient ratio.numerator (ratio.positive_denominator × divisor)
divide_quotient_by_integer (ComplexOfReal ratio) divisor =
  as_complex (ordinary_quotient ratio.numerator (ratio.positive_denominator × divisor))

same_ratio : ExactRatio → ExactRatio → Bool
same_ratio left right =
  left.positive_denominator > 0 && right.positive_denominator > 0 &&
  (left.numerator × right.positive_denominator ≟ right.numerator × left.positive_denominator)

same_quotient : OrdinaryQuotient → OrdinaryQuotient → Bool
same_quotient ZeroDivisor ZeroDivisor = True
same_quotient (RealRatio left) (RealRatio right) = same_ratio left right
same_quotient (ComplexOfReal left) (ComplexOfReal right) = same_ratio left right
same_quotient _ _ = False

cases : List (Integer, Integer, OrdinaryQuotient)
cases = [
  (7, 3, RealRatio (Ratio 7 3)),
  (-7, 3, ComplexOfReal (Ratio (-7) 3)),
  (7, -3, ComplexOfReal (Ratio (-7) 3)),
  (-7, -3, ComplexOfReal (Ratio 7 3)),
  (-6, 3, ComplexOfReal (Ratio (-2) 1)),
  (-8, -4, ComplexOfReal (Ratio 2 1)),
  (0, 3, RealRatio (Ratio 0 1)),
  (0, -3, ComplexOfReal (Ratio 0 1)),
  (3, 0, ZeroDivisor),
  (-3, 0, ZeroDivisor),
  (0, 0, ZeroDivisor),
  (-18446744073709551617, 3, ComplexOfReal (Ratio (-18446744073709551617) 3))]

check_case : (Integer, Integer, OrdinaryQuotient) → Bool
check_case (dividend, divisor, expected) = same_quotient (ordinary_quotient dividend divisor) expected

export
model_cases_pass : Bool
model_cases_pass = all check_case cases

ratio_text : ExactRatio → Text
ratio_text ratio = show ratio.numerator ++ "/" ++ show ratio.positive_denominator

export
describe : OrdinaryQuotient → Text
describe ZeroDivisor = "zero divisor"
describe (RealRatio ratio) = "real " ++ ratio_text ratio
describe (ComplexOfReal ratio) = "complex " ++ ratio_text ratio ++ " + 0i"
