module Tests

import HigherMathInference
import CompilationStage
import Contraction
import PresheafTensor

%default total

-- 1. Presheaf: restriction should infer the smaller open from the inclusion
-- witness, and identity/composition should compute as the ordinary laws say.
presheaf_identity_test :
  restrict Same (PatchSection 7) = PatchSection 7
presheaf_identity_test = Refl

presheaf_composition_test :
  restrict PointPatch (restrict PatchWhole (WholeSection 7))
    = restrict PointWhole (WholeSection 7)
presheaf_composition_test = Refl

-- 2. Two-dimensional unital algebras: once 1 is the identity, multiplication
-- is determined by j² = a + b j.  These three fixtures are the familiar
-- negative/zero/positive discriminant shapes.
complex_j_squared_test :
  multiply HigherMathInference.complexPlane
    HigherMathInference.j HigherMathInference.j = MkPair2 (-1) 0
complex_j_squared_test = Refl

split_j_squared_test :
  multiply HigherMathInference.splitPlane
    HigherMathInference.j HigherMathInference.j = MkPair2 1 0
split_j_squared_test = Refl

dual_j_squared_test :
  multiply HigherMathInference.dualNumbers
    HigherMathInference.j HigherMathInference.j = MkPair2 0 0
dual_j_squared_test = Refl

complex_shape_test :
  shape HigherMathInference.complexPlane = ComplexPlaneShape
complex_shape_test = Refl

split_shape_test :
  shape HigherMathInference.splitPlane = SplitPlaneShape
split_shape_test = Refl

dual_shape_test :
  shape HigherMathInference.dualNumbers = DualNumberShape
dual_shape_test = Refl

-- 3. Ostrowski forcing example.  This is deliberately a test of the desired
-- classification boundary, not a fake proof of Ostrowski's theorem.
ostrowski_usual_example_test :
  classifyRationalAbsoluteValueExample UsualExample = UsualArchimedean
ostrowski_usual_example_test = Refl

ostrowski_5_adic_example_test :
  classifyRationalAbsoluteValueExample (PAdicExample 5) = PAdic 5
ostrowski_5_adic_example_test = Refl

-- 4. Einstein index notation from the programmer-keyboard glyph inventory.
-- The surface spelling itself supplies useful constraints:
--   ᵢ ⱼ ₖ are lower indices; ⁱ ʲ ᵏ are upper indices.
-- An index occurring once is free.  The same index occurring exactly once
-- lower and exactly once upper is contracted.  Repetition at the same height
-- is invalid only under the strict Einstein-product interpretation; the
-- compilation-planning tests below separately allow elementwise indexed work.
sub_i_is_lower_test :
  indexFromGlyph 'ᵢ' = Just (Occurs IAxis Lower)
sub_i_is_lower_test = Refl

sup_i_is_upper_test :
  indexFromGlyph 'ⁱ' = Just (Occurs IAxis Upper)
sup_i_is_upper_test = Refl

free_lower_j_test :
  roleFor JAxis (occurrencesFromGlyphs ['A', 'ⱼ']) = FreeLower
free_lower_j_test = Refl

free_upper_k_test :
  roleFor KAxis (occurrencesFromGlyphs ['v', 'ᵏ']) = FreeUpper
free_upper_k_test = Refl

contract_i_test :
  roleFor IAxis (occurrencesFromGlyphs ['A', 'ᵢ', 'B', 'ⁱ']) = Contracted
contract_i_test = Refl

same_tensor_trace_test :
  roleFor IAxis (occurrencesFromGlyphs ['T', 'ⁱ', 'ᵢ']) = Contracted
same_tensor_trace_test = Refl

strict_einstein_duplicate_lower_is_invalid_test :
  roleFor IAxis (occurrencesFromGlyphs ['A', 'ᵢ', 'B', 'ᵢ'])
    = InvalidRepeated
strict_einstein_duplicate_lower_is_invalid_test = Refl

matrix_times_vector_signature_test :
  signatureFromGlyphs ['T', 'ⁱ', 'ⱼ', 'v', 'ʲ']
    = Signature FreeUpper Contracted Absent
matrix_times_vector_signature_test = Refl

-- 5. A scripted index also generates an indexed-computation constraint.  The
-- surrounding operator keeps elementwise multiplication distinct from strict
-- Einstein contraction; the glyph alone does not choose machine lowering.
elementwise_lower_i_infers_iteration_test :
  computationFromGlyphs ElementwiseMultiply ['a', 'ᵢ', 'b', 'ᵢ']
    = ElementwiseOver [IAxis]
elementwise_lower_i_infers_iteration_test = Refl

strict_lower_i_repetition_stays_invalid_test :
  computationFromGlyphs StrictEinsteinProduct ['a', 'ᵢ', 'b', 'ᵢ']
    = EinsteinProduct (Signature InvalidRepeated Absent Absent)
strict_lower_i_repetition_stays_invalid_test = Refl

elementwise_i_j_infers_two_iteration_axes_test :
  computationFromGlyphs ElementwiseMultiply
    ['a', 'ᵢ', 'ⱼ', 'b', 'ᵢ', 'ⱼ']
    = ElementwiseOver [IAxis, JAxis]
elementwise_i_j_infers_two_iteration_axes_test = Refl

-- 6. Compilation-stage indexed-work contract.
--
-- R is a useful semantic precedent here: ordinary `x * y` is elementwise,
-- while `%*%` is a distinct matrix product.  That is a source-language
-- semantic distinction, not a promise that `*` literally becomes SIMD.
--
-- The compiler invariant we want first is therefore weaker and cleaner:
-- once type/index inference says "this is indexed work over i", that fact must
-- survive into compilation planning instead of collapsing into unrelated
-- scalar expressions.  Realization may initially be a scalar indexed loop,
-- SIMD, or GPU fragment work.  SIMD/GPU are preferred but not yet mandatory.
-- Branching remains an open question rather than being forbidden prematurely.

elementwise_i_reaches_compilation_test :
  planIndexedWork ElementwiseIndexed IAxis = IndexedWork IAxis ElementwiseIndexed
elementwise_i_reaches_compilation_test = Refl

einstein_j_reaches_compilation_test :
  planIndexedWork EinsteinContracted JAxis = IndexedWork JAxis EinsteinContracted
einstein_j_reaches_compilation_test = Refl

scalar_loop_is_acceptable_test :
  realizationPolicy ScalarIndexedLoop = Acceptable
scalar_loop_is_acceptable_test = Refl

simd_is_preferred_test :
  realizationPolicy SIMDIndexed = Preferred
simd_is_preferred_test = Refl

gpu_fragment_is_preferred_test :
  realizationPolicy GPUFragmentIndexed = Preferred
gpu_fragment_is_preferred_test = Refl

branching_is_left_open_test :
  realizationPolicy BranchingIndexed = OpenQuestion
branching_is_left_open_test = Refl

-- 7. Typed contraction itself, not only glyph counting.
--
-- These are actual mathematical vectors/covectors over one named space.  A
-- covector eats a vector from the same space and returns a scalar.  There is no
-- implicit metric operation turning a vector into a covector, so two vectors do
-- not become contractible merely because their coordinate counts happen to
-- match.
plane_pairing_test :
  contract
    (planeCovector 5 7)
    (planeVector 3 4) = 43
plane_pairing_test = Refl

contraction_linear_in_vector_test :
  contract
    (planeCovector 5 7)
    (addVector (planeVector 3 4) (planeVector 2 (-1)))
  = contract (planeCovector 5 7) (planeVector 3 4)
      + contract (planeCovector 5 7) (planeVector 2 (-1))
contraction_linear_in_vector_test = Refl

contraction_linear_in_covector_test :
  contract
    (addCovector (planeCovector 5 7) (planeCovector (-2) 1))
    (planeVector 3 4)
  = contract (planeCovector 5 7) (planeVector 3 4)
      + contract (planeCovector (-2) 1) (planeVector 3 4)
contraction_linear_in_covector_test = Refl

contraction_respects_scalar_multiplication_test :
  contract
    (planeCovector 5 7)
    (scaleVector 3 (planeVector 3 4))
  = 3 * contract (planeCovector 5 7) (planeVector 3 4)
contraction_respects_scalar_multiplication_test = Refl

-- 8. Presheaf tensor restriction already sketched on this branch.
-- The finite executable model intentionally represents elementary tensors only;
-- it does not fake the balanced quotient construction of a general tensor
-- product.  What is pinned here is the restriction law that is already settled.
presheaf_tensor_restriction_test :
  restrictTensor PatchWhole
    (TensorSection (WholeSection 2) (WholeSection 3))
  = TensorSection (PatchSection 2) (PatchSection 3)
presheaf_tensor_restriction_test = Refl

presheaf_tensor_identity_test :
  restrictTensor Same
    (TensorSection (PatchSection 2) (PatchSection 3))
  = TensorSection (PatchSection 2) (PatchSection 3)
presheaf_tensor_identity_test = Refl

presheaf_tensor_composition_test :
  restrictTensor PointPatch
    (restrictTensor PatchWhole
      (TensorSection (WholeSection 2) (WholeSection 3)))
  = restrictTensor PointWhole
      (TensorSection (WholeSection 2) (WholeSection 3))
presheaf_tensor_composition_test = Refl

main : IO ()
main = putStrLn "higher-math constraint inference sketches: ok"
