#!/bin/sh
set -eu

repo_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
toolchain_dir=${EDRIC_TOOLCHAIN_DIR:-"$repo_root/.tools"}
scheme="$toolchain_dir/bin/scheme"
make_command=${MAKE:-make}

usage() {
    cat <<'USAGE'
usage: ./edric [scheme|bootstrap|test|all]

  scheme     install the pinned threaded Chez Scheme under .tools
  bootstrap  install Chez Scheme, then bootstrap Idris 2
  test       run the focused Edric handoff test with an existing build
  all        install Chez Scheme, bootstrap Idris 2, and run the handoff test

With no command, all is used.
USAGE
}

install_scheme() {
    EDRIC_TOOLCHAIN_DIR="$toolchain_dir" "$repo_root/scripts/ensure-chez.sh" >/dev/null
}

bootstrap() {
    install_scheme
    "$make_command" -C "$repo_root" bootstrap SCHEME="$scheme"
}

smoke_test() {
    "$make_command" -C "$repo_root" test only=idris2/basic/edric001
    "$make_command" -C "$repo_root" test only=idris2/basic/edric002
}

command=${1:-all}
case "$command" in
    scheme)
        install_scheme
        printf '%s\n' "$scheme"
        ;;
    bootstrap)
        bootstrap
        ;;
    test)
        smoke_test
        ;;
    all)
        bootstrap
        smoke_test
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
