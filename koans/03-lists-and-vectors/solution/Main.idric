module Main

import Data.Vect

%default total

numbers : List Nat
numbers = [2, 4, 6]

exactly_three : Vect 3 Nat
exactly_three = [2, 4, 6]

prepend : a → Vect n a → Vect (S n) a
prepend value values = value :: values

main : IO ()
main = do
  printLn (List.length numbers)
  printLn (prepend 0 exactly_three)
