set -e

. ../../../testutils.sh

example_dir=../../../../examples/higher-math-constraint-inference
fixture_dir=build/higher-math-fixtures
mkdir -p "$fixture_dir"

cp "$example_dir/HigherMathInference.idric" "$fixture_dir/HigherMathInference.idric"
cp "$example_dir/CompilationStage.idric" "$fixture_dir/CompilationStage.idric"
cp "$example_dir/Contraction.idric" "$fixture_dir/Contraction.idric"
cp "$example_dir/PresheafTensor.idric" "$fixture_dir/PresheafTensor.idric"
cp "$example_dir/PresheafTensorTests.idric" "$fixture_dir/PresheafTensorTests.idric"
cp "$example_dir/Tests.idric" "$fixture_dir/Tests.idric"

# Keep the Idric extension all the way into the compiler: these fixtures use
# filename-scoped Idric syntax, including the Unicode function arrow.  Check
# the focused presheaf module as well as the combined executable receipt so no
# added higher-math test source remains outside CI.
(
  cd "$fixture_dir"

  if ! "$idris2" --check PresheafTensorTests.idric >presheaf-check.log 2>&1; then
    cat presheaf-check.log >&2
    exit 1
  fi

  if ! "$idris2" Tests.idric -o higher-math-constraint-inference >combined-build.log 2>&1; then
    cat combined-build.log >&2
    exit 1
  fi

  ./build/exec/higher-math-constraint-inference
)
