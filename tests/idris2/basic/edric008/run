. ../../../testutils.sh

cp ../../../../examples/higher-math-constraint-inference/HigherMathInference.idric HigherMathInference.idr
cp ../../../../examples/higher-math-constraint-inference/CompilationStage.idric CompilationStage.idr
cp ../../../../examples/higher-math-constraint-inference/Contraction.idric Contraction.idr
cp ../../../../examples/higher-math-constraint-inference/PresheafTensor.idric PresheafTensor.idr
cp ../../../../examples/higher-math-constraint-inference/Tests.idric Tests.idr

"$idris2" Tests.idr -o higher-math-constraint-inference >/dev/null
./build/exec/higher-math-constraint-inference

# Negative type-checking receipt: a covector over PlaneSpace must not consume a
# vector over ThreeSpace.  Require the failure to name both spaces so an
# unrelated parse/module error cannot satisfy this test by accident.
if "$idris2" Bad.idr >/dev/null 2>bad.err; then
  echo "mismatched contraction unexpectedly typechecked" >&2
  exit 1
fi

if ! grep -q 'PlaneSpace' bad.err || ! grep -q 'ThreeSpace' bad.err; then
  cat bad.err >&2
  echo "mismatched contraction failed for the wrong reason" >&2
  exit 1
fi

echo "mismatched contraction rejected"
