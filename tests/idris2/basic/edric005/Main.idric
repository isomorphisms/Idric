module Main

import IdrisCompat

unicode_function : Integer→Integer
unicode_function = \value⇒value + 1

unicode_apply : (Integer→Integer)→Integer→Integer
unicode_apply = \function⇒\value⇒function value

ascii_function : Integer -> Integer
ascii_function = \value => value + 1

unicode_order : Bool
unicode_order = 1≤2

ascii_order : Bool
ascii_order = 1 <= 2

syntax_literal : String
syntax_literal = "-> => → ⇒ ← ≤"

case_simple : Either Integer Integer→Integer
case_simple result =
  case result of
    Left problem ⇒ problem
    Right headers ⇒ headers + 1

case_right_do : Either Integer Integer→IO Integer
case_right_do result =
  case result of
    Left problem ⇒ pure problem
    Right headers ⇒ do
      pure (headers + 1)

case_do_boundary : Either Integer Integer→IO Integer
case_do_boundary result =
  case result of
    Left problem ⇒ do
      first←pure (problem + 1)
      pure (first + 1)
    Right headers ⇒ pure (headers + 10)

nested_case_do : Either Integer (Either Integer Integer)→IO Integer
nested_case_do result =
  case result of
    Left problem ⇒ pure problem
    Right headers ⇒ do
      let marker = 1
      case headers of
        Left problem ⇒ pure (problem + marker)
        Right value ⇒ do
          first←pure (value + marker)
          pure (first + 1)

case_let_case : Either Integer Integer→IO Integer
case_let_case result =
  case result of
    Left problem ⇒ pure problem
    Right headers ⇒ do
      let metadata = case headers of
            0 ⇒ 10
            _ ⇒ 20
      pure metadata

fetch_like : Integer→Integer→Integer→Integer→IO (Either Integer Integer)
fetch_like request headers body_path metadata_path =
  pure (Right 0)

right_result : Integer→IO (Either Integer Integer)
right_result value = pure (Right value)

cleanup_like : Integer→Integer→IO ()
cleanup_like body_path metadata_path = pure ()

downstream_shape : Either Integer Integer→IO (Either Integer Integer)
downstream_shape result =
  case result of
    Left problem ⇒ pure (Left problem)
    Right headers ⇒ do
      let body = headers + 1
      pid←pure 2
      temp_root←pure 3
      let prefix = temp_root + pid
      let body_path = prefix + 1
      let metadata_path = prefix + 2
      fetch_result←fetch_like
        (body + headers) headers body_path metadata_path
      case fetch_result of
        Left problem ⇒ pure (Left problem)
        Right result_code ⇒ do
          metadata_result←right_result metadata_path
          body_result←right_result body_path
          cleanup_like body_path metadata_path
          let metadata = case metadata_result of
                Left _ ⇒ 0
                Right text ⇒ text
          if result_code /= 0
            then pure (Left metadata)
            else case body_result of
              Left _ ⇒ pure (Left 100)
              Right response_body ⇒ pure (Right (metadata + response_body))

main : IO ()
main = do
  unicode_text←pure "unicode bind"
  ascii_text <- pure "ascii bind"
  putStrLn unicode_text
  putStrLn ascii_text
  printLn (unicode_function 4)
  printLn (unicode_apply unicode_function 4)
  printLn (ascii_function 4)
  printLn unicode_order
  printLn ascii_order
  printLn idris_compat_value
  putStrLn syntax_literal
  printLn (case_simple (Right 4))
  right_do←case_right_do (Right 6)
  printLn right_do
  boundary_left←case_do_boundary (Left 3)
  boundary_right←case_do_boundary (Right 3)
  printLn boundary_left
  printLn boundary_right
  nested_left←nested_case_do (Right (Left 5))
  nested_right←nested_case_do (Right (Right 5))
  printLn nested_left
  printLn nested_right
  let_case←case_let_case (Right 0)
  printLn let_case
  downstream←downstream_shape (Right 1)
  printLn downstream
