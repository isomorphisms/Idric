module Main

import IdrisCompat

unicode_function : Integer→Integer
unicode_function = \value⇒value + 1

unicode_apply : (Integer→Integer)→Integer→Integer
unicode_apply = \function⇒\value⇒function value

ascii_function : Integer -> Integer
ascii_function = \value => value + 1

unicode_order : Bool
unicode_order = 1≤2

ascii_order : Bool
ascii_order = 1 <= 2

syntax_literal : String
syntax_literal = "-> => → ⇒ ← ≤"

local_prefix : Integer → IO Integer
local_prefix value = do
  let prefix = value + 1
  pure prefix

main : IO ()
main = do
  unicode_text←pure "unicode bind"
  ascii_text <- pure "ascii bind"
  putStrLn unicode_text
  putStrLn ascii_text
  printLn (unicode_function 4)
  printLn (unicode_apply unicode_function 4)
  printLn (ascii_function 4)
  printLn unicode_order
  printLn ascii_order
  printLn idris_compat_value
  putStrLn syntax_literal
  prefix_value ← local_prefix 4
  printLn prefix_value
